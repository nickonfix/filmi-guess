# Server port (Render/Railway set this automatically)
PORT=3001

# Supabase question bank (optional — without these the server uses the
# bundled question bank). Set both to load questions from the `questions`
# table; see supabase/schema.sql and scripts/seed.ts.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
